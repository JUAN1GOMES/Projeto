<div class="container">

<h1>Cadastro de Usuário</h1>

<form action="/usuarios" method="POST">

<label>Nome</label>
<input type="text" name="nome" required>

<label>Email</label>
<input type="email" name="email" required>

<label>Idade</label>
<input type="number" name="idade" required>

<button>Cadastrar</button>

</form>

</div>