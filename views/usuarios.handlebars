<div class="container">


<div class="topo">
    <h1>Usuários</h1>

    <button type="button" onclick="window.location.href='/'">
        Cadastrar Novo Usuário
    </button>
</div>

<table>
    <caption>Lista de usuários cadastrados</caption>

    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Idade</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>

    <tbody>
        {{#each usuarios}}

        <tr>
            <td>{{nome}}</td>
            <td>{{email}}</td>
            <td>{{idade}}</td>

            <td>

    <a href="/usuarios/editar/{{id}}" class="botao editar">
        Editar
    </a>

    <form action="/usuarios/remover/{{id}}" method="POST" style="display:inline;">
        <button type="submit" class="excluir">
            Excluir
        </button>
    </form>

    <button type="button" onclick="entrarSala('{{id}}','{{nome}}')">
        Ir para Salas
    </button>

</td>
        </tr>

        {{/each}}
    </tbody>
</table>


</div>

<script>
function entrarSala(id, nome) {
    localStorage.setItem("usuarioId", id);
    localStorage.setItem("usuario", nome);

    window.location.href = "/batata";
}
</script>
